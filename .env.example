# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://gkwpjtbrecoesxyoybto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public application URL
NEXT_PUBLIC_SITE_URL=https://your-vercel-domain.vercel.app

# Server-only secret used by request-aware public-search abuse protection.
# Keep this out of browser bundles, source control, and client-side code.
SUPABASE_SERVICE_ROLE_KEY=

# Legacy account phone-linking via Twilio Verify WhatsApp (server-only)
# Required only until pre-phone email/password accounts complete controlled phone linking.
DEBA_TWILIO_API_KEY=
DEBA_TWILIO_API_SECRET=
DEBA_TWILIO_VERIFY_SERVICE_SID=

# Transactional email (server-only)
RESEND_API_KEY=
RESEND_FROM_EMAIL=DEBA <notifications@your-domain.example>

# Internal DB -> Next.js notification webhook (server-only)
DEBA_NOTIFICATION_WEBHOOK_SECRET=

# Phase 4.2 internal buyer-intent webhook (server-only)
DEBA_BUYER_INTENT_WEBHOOK_SECRET=

# Phase 4.3 authenticated Vercel Cron
CRON_SECRET=

# Phase 4.4 server-only embeddings provider
DEBA_EMBEDDING_API_URL=
DEBA_EMBEDDING_API_KEY=
DEBA_EMBEDDING_MODEL=

# Phase 5.1 server-only AI broker / vision providers
DEBA_BROKER_API_URL=
DEBA_BROKER_API_KEY=
DEBA_BROKER_MODEL=
DEBA_VISION_API_URL=
DEBA_VISION_API_KEY=
DEBA_VISION_MODEL=

# Payments
PAYMENT_PROVIDER=paymob
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_PUBLIC_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_IDS=

# Shipping
SHIPPING_PROVIDER=manual
